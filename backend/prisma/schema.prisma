generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String        @id @db.VarChar(36)
  name         String        @db.VarChar(255)
  email        String        @unique @db.VarChar(255)
  password     String        @db.VarChar(255)
  phone        String        @db.VarChar(20)
  role         UserRole      @default(CLIENT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamp(0)
  appointments Appointment[]

  @@map("users")
}

model Service {
  id                  String               @id @db.VarChar(36)
  name                String               @unique @db.VarChar(100)
  description         String?              @db.Text
  price               Decimal              @db.Decimal(10, 2)
  durationMinutes     Int                  @map("duration_minutes")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @db.Timestamp(0)
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamp(0)
  appointmentServices AppointmentService[]

  @@index([isActive, name], map: "services_isActive_name_idx")
  @@map("services")
}

model BusinessHour {
  id          Int       @id @default(autoincrement())
  dayOfWeek   DayOfWeek @unique @map("day_of_week")
  openingTime DateTime  @map("opening_time") @db.Time(0)
  lunchStart  DateTime  @map("lunch_start") @db.Time(0)
  lunchEnd    DateTime  @map("lunch_end") @db.Time(0)
  closingTime DateTime  @map("closing_time") @db.Time(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("business_hours")
}

model Appointment {
  id        String               @id @db.VarChar(36)
  clientId  String               @map("client_id") @db.VarChar(36)
  startAt   DateTime             @map("start_at") @db.DateTime(0)
  endAt     DateTime             @map("end_at") @db.DateTime(0)
  status    AppointmentStatus    @default(PENDING)
  createdAt DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  services  AppointmentService[]
  client    User                 @relation(fields: [clientId], references: [id])

  @@index([clientId, startAt])
  @@index([startAt, endAt, status])
  @@map("appointments")
}

model AppointmentService {
  id                      String            @id @db.VarChar(36)
  appointmentId           String            @map("appointment_id") @db.VarChar(36)
  serviceId               String            @map("service_id") @db.VarChar(36)
  sequence                Int               @db.UnsignedSmallInt
  serviceNameSnapshot     String            @map("service_name_snapshot") @db.VarChar(100)
  servicePriceSnapshot    Decimal           @map("service_price_snapshot") @db.Decimal(10, 2)
  serviceDurationSnapshot Int               @map("service_duration_snapshot")
  status                  AppointmentStatus @default(PENDING)
  createdAt               DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  appointment             Appointment       @relation(fields: [appointmentId], references: [id])
  service                 Service           @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
  @@unique([appointmentId, sequence])
  @@index([serviceId])
  @@index([status])
  @@map("appointment_services")
}

enum UserRole {
  CLIENT
  ADMIN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}
